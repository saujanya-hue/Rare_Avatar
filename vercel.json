{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/main"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/main"
    }
  ]
}
